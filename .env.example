# Copy to `.env` and fill in real values. `examples/run-stack.ps1` loads
# KEY=VALUE lines from `.env` in the repo root on start; values already
# present in the process environment win over the file. Never commit a
# real `.env` (it is covered by `.gitignore`).
#
# Placeholder values below are inert examples, not secrets.

# OpenAI provider key (config/bifrost.json providers.openai).
# Falls back to "unused" when unset; live OpenAI calls need a real key.
OPENAI_API_KEY=sk-your-openai-key-here

# Deterministic mock-provider key (config/bifrost.json providers.mock
# and providers.broken). "unused" is fine for the demo/eval flows.
MOCK_API_KEY=unused

# Tavily search/extract relay credential (config/bifrost.json
# relays.tavily). Falls back to "unused" when unset.
TAVILY_API_KEY=tvly-your-tavily-key-here

# Setup token the stack script sends as X-Bifrost-Setup-Token to disable
# auth enforcement inside throwaway containers. Default: dev-setup-token.
BIFROST_SETUP_TOKEN=dev-setup-token

# Optional: a provisioned Bifrost virtual key, sent as x-bf-vk on every
# probe. When set, the stack script skips the auth-disabling step.
# BF_VIRTUAL_KEY=bf-vk-your-key-here

# Optional: log level for bifrost-http inside the container
# (docker-entrypoint.sh `-log-level`). Default when unset: info.
# BIFROST_LOG_LEVEL=info
