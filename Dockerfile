# syntax=docker/dockerfile:1

# Pinned upstream commit. Bumping this is a deliberate act: the plugin is built
# against the same Bifrost modules that the binary links, so drift here is how
# you get "plugin was built with a different version of package" at startup.
ARG BIFROST_COMMIT=54ad3abec4fbbdaedf59414415094760fb9aa7e9
ARG GO_IMAGE=golang:1.27.3-bookworm

# ---------------------------------------------------------------------------
# Stage 1: build Bifrost dynamically, plus the plugin and the sidecar.
#
# Two things make this non-obvious:
#
#  * DYNAMIC. The Makefile's static branch adds -extldflags "-static" and the
#    sqlite_static tag, and a statically linked binary cannot load Go plugins.
#    We reproduce the dynamic branch directly instead of calling `make build`,
#    because `build` depends on `build-ui` and we do not want node here.
#
#  * go.work. transports/bifrost-http imports framework/mcpdiscovery, which is
#    not in the published framework module yet. Building with GOWORK=off fails
#    with "no required module provides package". A workspace that `use`s the
#    local modules fixes it, and has the side benefit of making the binary and
#    the plugin resolve identical versions of every Bifrost package.
#
# The UI: main.go has `//go:embed all:ui` and ui/ is generated by build-ui, so
# it is absent from a clean checkout. Our product UI is the sidecar's own React
# app, so a placeholder is enough for the embed to resolve.
# ---------------------------------------------------------------------------
FROM ${GO_IMAGE} AS builder

ARG BIFROST_COMMIT

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
      make \
      gcc \
      libc6-dev \
      libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --filter=blob:none https://github.com/maximhq/bifrost.git bifrost \
    && cd bifrost \
    && git checkout "${BIFROST_COMMIT}"

# Bring our plugin into the upstream tree so it joins the workspace and shares
# the exact module graph the binary is built from.
COPY plugin/ /src/bifrost/plugins/contextcurator/

WORKDIR /src/bifrost
RUN mkdir -p transports/bifrost-http/ui \
    && printf '%s\n' '<!doctype html><title>Bifrost</title><p>UI is served by cc-sidecar.</p>' \
         > transports/bifrost-http/ui/index.html \
    && go work init ./cli ./core ./framework ./transports \
    && for d in ./plugins/*/; do \
         if [ -f "$d/go.mod" ]; then go work use "$d"; fi; \
       done

WORKDIR /src/bifrost/transports/bifrost-http
RUN --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
      go build \
        -ldflags="-w -s -X main.Version=v0.0.0-dev" \
        -a -trimpath \
        -o /out/bifrost-http .

WORKDIR /src/bifrost/plugins/contextcurator
RUN --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
      go build -buildmode=plugin -trimpath -o /out/contextcurator.so .

WORKDIR /src/repo
COPY go.work ./
COPY plugin/ ./plugin/
COPY sidecar/ ./sidecar/
COPY examples/eval/ ./examples/eval/
WORKDIR /src/repo/sidecar
RUN --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
      go build -trimpath -o /out/cc-sidecar .

WORKDIR /src/mock-provider
COPY examples/mock-provider/ ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
      go build -trimpath -o /out/mock-provider .

# ---------------------------------------------------------------------------
# Stage 2: build the console UI. The frontend lives in web/ as a Next.js App
# Router app with `output: "standalone"`; the image compiles it from source
# so a fresh clone never depends on a committed .next/. The build output is
# normalized into /out-web (Next standalone server) plus /out-web-legacy
# (static dist, when the web/ build still emits one): the runtime serves the
# Next console from /app/web and keeps /srv/web as the sidecar's legacy
# static fallback. web/temp1.html stays in the repo unreferenced.
# ---------------------------------------------------------------------------
FROM node:22-bookworm AS uibuild

WORKDIR /web
COPY web/package*.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN (npm run build || (mkdir -p dist && cp temp1.html dist/index.html)) \
    && mkdir -p /out-web /out-web-legacy \
    && if [ -f .next/standalone/server.js ]; then \
         cp -a .next/standalone/. /out-web/ \
         && mkdir -p /out-web/.next \
         && cp -a .next/static/. /out-web/.next/static/ \
         && (cp -a public/. /out-web/public/ || true); \
       fi \
    && (cp -a dist/. /out-web-legacy/ 2>/dev/null || true) \
    && ls -la /out-web /out-web-legacy

# ---------------------------------------------------------------------------
# Stage 3: runtime. Same Debian release as the builder, so the libc and the
# libsqlite3 the binary and plugin were linked against are the ones present.
# Node 22 for the Next standalone console is copied from the uibuild stage
# (same bookworm userland, so no nodesource setup is needed).
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      libsqlite3-0 \
      tini \
      bash \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uibuild /usr/local/bin/node /usr/local/bin/node

WORKDIR /app

COPY --from=builder /out/bifrost-http      /usr/local/bin/bifrost-http
COPY --from=builder /out/cc-sidecar        /usr/local/bin/cc-sidecar
COPY --from=builder /out/mock-provider     /usr/local/bin/mock-provider
COPY --from=builder /out/contextcurator.so /plugins/contextcurator.so
COPY config/               /app/config/
COPY --from=uibuild /out-web/         /app/web/
COPY --from=uibuild /out-web-legacy/  /srv/web/
COPY web/temp1.html        /srv/web/temp1.html
COPY docker-entrypoint.sh  /usr/local/bin/docker-entrypoint.sh

RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
    && mkdir -p /data/bifrost \
    && node --version

ENV BIFROST_APP_DIR=/data/bifrost
ENV CC_SIDECAR_URL=http://127.0.0.1:8090
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

EXPOSE 3000 8080 8090

HEALTHCHECK --interval=10s --timeout=3s --start-period=40s --retries=6 \
  CMD ["cc-sidecar", "-check", "http://127.0.0.1:8090/healthz"]

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/docker-entrypoint.sh"]
